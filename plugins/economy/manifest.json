{
  "manifest_version": 1,
  "id": "neomega.economy",
  "version": "2.1.0",
  "host_api": {
    "major": 1,
    "min_minor": 4
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 2,
  "subscriptions": [
    {
      "name": "chat",
      "kind": "chat.received",
      "delivery": "durable"
    },
    {
      "name": "join",
      "kind": "player.list_added",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [
      "framework.command.execute",
      "framework.scoreboard.get",
      "framework.scoreboard.add",
      "framework.scoreboard.objectives.list",
      "framework.scoreboard.objectives.add",
      "framework.scoreboard.objectives.setdisplay"
    ],
    "players": [
      "list"
    ],
    "services": [
      "plugin.neomega.players.resolve"
    ],
    "purposes": {
      "event:chat.received": "接收玩家的 !余额、!转账、!流水 命令",
      "event:player.list_added": "玩家进服时发放初始金币和离线期间的收入",
      "operation:framework.command.execute": "回复玩家并通知转账双方",
      "operation:framework.scoreboard.get": "从计分板读取玩家余额",
      "operation:framework.scoreboard.add": "在计分板上给玩家加减金币",
      "operation:framework.scoreboard.objectives.list": "启动时检查货币计分板是否存在",
      "operation:framework.scoreboard.objectives.add": "货币计分板不存在时新建",
      "operation:framework.scoreboard.objectives.setdisplay": "按配置把货币计分板显示在侧边栏、玩家列表或名字下方",
      "players:list": "确认玩家是否在线、身份和当前名字，并在在线玩家里查找转账对象",
      "service:plugin.neomega.players.resolve": "按名字查找不在线的转账对象"
    }
  },
  "dependencies": [
    {
      "id": "neomega.players",
      "major": 2,
      "min_version": "2.0.0"
    }
  ],
  "exports": [
    {
      "name": "balance",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "required": [
          "player_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "pending": {
            "type": "boolean"
          }
        },
        "required": [
          "balance",
          "currency",
          "pending"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "grant",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "pattern": "^.{1,32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^.{1,64}$"
          }
        },
        "required": [
          "player_id",
          "amount",
          "reason",
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer"
          },
          "duplicate": {
            "type": "boolean"
          },
          "currency": {
            "type": "string"
          },
          "pending": {
            "type": "boolean"
          }
        },
        "required": [
          "balance",
          "duplicate",
          "currency",
          "pending"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pay",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "pattern": "^.{1,32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^.{1,64}$"
          }
        },
        "required": [
          "player_id",
          "amount",
          "reason",
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer"
          },
          "duplicate": {
            "type": "boolean"
          },
          "currency": {
            "type": "string"
          },
          "pending": {
            "type": "boolean"
          }
        },
        "required": [
          "balance",
          "duplicate",
          "currency",
          "pending"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "transfer",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "from_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "pattern": "^.{1,32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^.{1,64}$"
          }
        },
        "required": [
          "from_id",
          "to_id",
          "amount",
          "reason",
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer"
          },
          "duplicate": {
            "type": "boolean"
          },
          "currency": {
            "type": "string"
          },
          "pending": {
            "type": "boolean"
          }
        },
        "required": [
          "balance",
          "duplicate",
          "currency",
          "pending"
        ],
        "additionalProperties": false
      }
    }
  ]
}
