{
  "manifest_version": 1,
  "id": "neomega.economy",
  "version": "2.0.0",
  "host_api": {
    "major": 1,
    "min_minor": 4
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 2,
  "subscriptions": [
    {
      "name": "chat",
      "kind": "chat.received",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [
      "framework.command.execute"
    ],
    "players": [
      "list"
    ],
    "services": [
      "plugin.neomega.players.resolve"
    ],
    "purposes": {
      "event:chat.received": "接收玩家的 !余额、!转账、!流水 命令",
      "operation:framework.command.execute": "回复玩家并通知转账双方",
      "players:list": "确认发命令的玩家身份，并在在线玩家里查找转账对象",
      "service:plugin.neomega.players.resolve": "按名字查找不在线的转账对象"
    }
  },
  "dependencies": [
    {
      "id": "neomega.players",
      "major": 2,
      "min_version": "2.0.0"
    }
  ],
  "exports": [
    {
      "name": "balance",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "required": [
          "player_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "balance"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "grant",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "pattern": "^.{1,32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^.{1,64}$"
          }
        },
        "required": [
          "player_id",
          "amount",
          "reason",
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "balance",
          "duplicate"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pay",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "pattern": "^.{1,32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^.{1,64}$"
          }
        },
        "required": [
          "player_id",
          "amount",
          "reason",
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "balance",
          "duplicate"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "transfer",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "from_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "pattern": "^.{1,32}$"
          },
          "request_id": {
            "type": "string",
            "pattern": "^.{1,64}$"
          }
        },
        "required": [
          "from_id",
          "to_id",
          "amount",
          "reason",
          "request_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer",
            "minimum": 0
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "balance",
          "duplicate"
        ],
        "additionalProperties": false
      }
    }
  ]
}
