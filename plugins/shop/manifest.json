{
  "manifest_version": 1,
  "id": "neomega.shop",
  "version": "1.0.0",
  "host_api": {
    "major": 1,
    "min_minor": 4
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 1,
  "subscriptions": [
    {
      "name": "chat",
      "kind": "chat.received",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [
      "framework.command.execute"
    ],
    "players": [
      "list"
    ],
    "services": [
      "plugin.neomega.economy.pay",
      "plugin.neomega.economy.balance"
    ],
    "purposes": {
      "event:chat.received": "接收玩家的 !商店 命令和菜单回复",
      "operation:framework.command.execute": "发放购买的商品并回复玩家",
      "players:list": "确认发命令的玩家身份",
      "service:plugin.neomega.economy.pay": "购买商品时扣除金币",
      "service:plugin.neomega.economy.balance": "金币不足时告诉玩家当前余额"
    }
  },
  "dependencies": [
    {
      "id": "neomega.economy",
      "major": 2,
      "min_version": "2.0.0"
    }
  ],
  "exports": []
}
