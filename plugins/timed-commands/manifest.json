{
  "manifest_version": 1,
  "id": "neomega.timed-commands",
  "version": "1.0.0",
  "host_api": {
    "major": 1,
    "min_minor": 2
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 1,
  "subscriptions": [],
  "permissions": {
    "operations": [
      "framework.command.execute"
    ],
    "players": [],
    "services": [],
    "purposes": {
      "operation:framework.command.execute": "按时执行服主配置的命令并向全服广播"
    }
  },
  "dependencies": [],
  "exports": []
}
