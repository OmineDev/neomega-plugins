{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "utc_offset_hours": {
      "type": "integer",
      "title": "时区",
      "description": "与 UTC 相差的小时数，北京时间填 8",
      "minimum": -12,
      "maximum": 14,
      "default": 8
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "minutes": {
            "type": "integer",
            "title": "当天在线分钟数",
            "minimum": 1
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "奖励命令",
            "description": "{player} 会替换为获奖的玩家",
            "default": []
          },
          "message": {
            "type": "string",
            "title": "奖励提示",
            "description": "私聊发给获奖的玩家",
            "default": ""
          }
        },
        "required": [
          "minutes"
        ],
        "additionalProperties": false
      },
      "title": "每日在线奖励",
      "description": "当天在线时长正好达到设定分钟数时发放一次",
      "default": [
        {
          "minutes": 60,
          "commands": [
            "give {player} bread 5"
          ],
          "message": "今天已在线 1 小时，送你 5 个面包！"
        }
      ]
    },
    "coin_interval_minutes": {
      "type": "integer",
      "title": "金币间隔分钟数",
      "description": "当天在线每满这么多分钟发一次金币",
      "minimum": 1,
      "default": 30
    },
    "coins_per_interval": {
      "type": "integer",
      "title": "每次金币",
      "description": "需要安装经济插件，没装时不发；填 0 不发金币",
      "minimum": 0,
      "default": 5
    },
    "daily_coin_limit": {
      "type": "integer",
      "title": "每日金币上限",
      "description": "当天最多发这么多金币，最后一次按剩余额度发；填 0 不限",
      "minimum": 0,
      "default": 0
    }
  },
  "required": [],
  "additionalProperties": false
}
