{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "!home",
        "!家"
      ]
    },
    "max_homes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 3
    },
    "cooldown_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400,
      "default": 30
    },
    "warmup_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30,
      "default": 0
    },
    "allowed_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "overworld"
      ]
    },
    "cross_dimension": {
      "type": "boolean",
      "default": false
    },
    "check_for_blocks": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "additionalProperties": false
}
