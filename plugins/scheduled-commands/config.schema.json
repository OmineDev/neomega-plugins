{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "tasks": {
      "type": "array",
      "default": [],
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "schedule": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "interval"
                  },
                  "seconds": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 31536000
                  }
                },
                "required": [
                  "kind",
                  "seconds"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "daily"
                  },
                  "times": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 48,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
                    }
                  },
                  "timezone": {
                    "type": "string",
                    "default": "Asia/Shanghai"
                  }
                },
                "required": [
                  "kind",
                  "times",
                  "timezone"
                ],
                "additionalProperties": false
              }
            ]
          },
          "run_on_start": {
            "type": "boolean",
            "default": false
          },
          "resume_token": {
            "type": "string",
            "default": "",
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "commands",
          "schedule"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
