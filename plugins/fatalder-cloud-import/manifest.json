{
  "manifest_version": 1,
  "id": "fatalder.cloud-import",
  "version": "1.0.1",
  "host_api": {
    "major": 1,
    "min_minor": 0
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 1,
  "subscriptions": [
    {
      "name": "chat",
      "kind": "chat.received",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [
      "framework.command.execute",
      "framework.packet.send_json"
    ],
    "services": []
  },
  "dependencies": [],
  "exports": []
}
