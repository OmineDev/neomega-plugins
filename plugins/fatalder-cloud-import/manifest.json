{
  "manifest_version": 1,
  "id": "fatalder.cloud-import",
  "version": "1.2.0",
  "host_api": {
    "major": 1,
    "min_minor": 8
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 1,
  "subscriptions": [
    {
      "name": "chat",
      "kind": "chat.received",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [
      "framework.command.execute",
      "framework.packet.send_json"
    ],
    "services": [],
    "players": [
      "list",
      "observe"
    ],
    "packet_send_ids": [
      185
    ],
    "purposes": {
      "operation:framework.command.execute": "向管理员反馈导入报价、状态与操作结果",
      "operation:framework.packet.send_json": "发送经过身份核对的机器人权限请求",
      "event:chat.received": "接收并校验管理员发出的导入命令",
      "players:list": "将聊天玩家唯一匹配到管理员 UUID 白名单",
      "players:observe": "核对 Worker 机器人身份及权限变更读回",
      "packet_send:185": "发送 RequestPermissions，为已核验机器人授予 OP 或按配置恢复原权限"
    }
  },
  "dependencies": [],
  "exports": [
    {
      "name": "prepare",
      "major": 1,
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "name": "status",
      "major": 1,
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "name": "confirm",
      "major": 1,
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "name": "pause",
      "major": 1,
      "input_schema": {
        "type": "object",
        "required": [
          "request_key",
          "job_id",
          "control_id"
        ],
        "properties": {
          "request_key": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          },
          "control_id": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          }
        }
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "name": "resume",
      "major": 1,
      "input_schema": {
        "type": "object",
        "required": [
          "request_key",
          "job_id",
          "control_id"
        ],
        "properties": {
          "request_key": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          },
          "control_id": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          }
        }
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "name": "cancel",
      "major": 1,
      "input_schema": {
        "type": "object",
        "required": [
          "request_key",
          "job_id",
          "control_id"
        ],
        "properties": {
          "request_key": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          },
          "control_id": {
            "type": "string",
            "pattern": "(?s)^.{1,128}$"
          }
        }
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "name": "recover",
      "major": 1,
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      }
    }
  ]
}
