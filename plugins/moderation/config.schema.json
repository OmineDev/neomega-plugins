{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "writer_installations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "允许封禁/解封的调用安装 ID；空列表禁止写入。",
      "default": [],
      "title": "允许处罚的插件安装 ID"
    },
    "enforce": {
      "type": "boolean",
      "default": true,
      "title": "执行踢出"
    },
    "poll_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 5,
      "title": "扫描间隔（秒）"
    },
    "max_players": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "default": 256,
      "title": "最大玩家档案数"
    }
  },
  "required": [],
  "additionalProperties": false
}
