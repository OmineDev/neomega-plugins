{
  "manifest_version": 1,
  "id": "neomega.players",
  "version": "2.0.0",
  "host_api": {
    "major": 1,
    "min_minor": 4
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 2,
  "subscriptions": [
    {
      "name": "joins",
      "kind": "player.list_added",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [],
    "players": [
      "list"
    ],
    "services": [],
    "purposes": {
      "event:player.list_added": "玩家进服时记录名字和身份",
      "players:list": "确认进服玩家的完整身份"
    }
  },
  "dependencies": [],
  "exports": [
    {
      "name": "resolve",
      "major": 1,
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "xuid": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "xuid": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "last_seen": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "uuid",
          "xuid",
          "names",
          "last_seen"
        ],
        "additionalProperties": false
      }
    }
  ]
}
