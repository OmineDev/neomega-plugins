{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "max_routes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "default": 128
    },
    "lease_seconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300,
      "default": 60
    },
    "queue_capacity": {
      "type": "integer",
      "minimum": 8,
      "maximum": 256,
      "default": 128
    },
    "messages_per_second": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "max_message_bytes": {
      "type": "integer",
      "minimum": 32,
      "maximum": 4096,
      "default": 2048
    }
  },
  "required": [],
  "additionalProperties": false
}
