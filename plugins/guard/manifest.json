{
  "manifest_version": 1,
  "id": "neomega.guard",
  "version": "1.0.0",
  "host_api": {
    "major": 1,
    "min_minor": 2
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 1,
  "subscriptions": [
    {
      "name": "chat",
      "kind": "chat.received",
      "delivery": "durable"
    },
    {
      "name": "join",
      "kind": "player.list_added",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [
      "framework.command.execute"
    ],
    "players": [
      "list"
    ],
    "services": [],
    "purposes": {
      "event:chat.received": "统计玩家发言以发现刷屏，并接收管理员的 !守卫记录 命令",
      "event:player.list_added": "在玩家进服时检查等级、昵称和在线人数",
      "operation:framework.command.execute": "查询玩家等级，发送提示和标题，踢出违规玩家或执行设置的处罚命令",
      "players:list": "统计在线人数，确认进服和发言的玩家身份"
    }
  },
  "dependencies": [],
  "exports": []
}
