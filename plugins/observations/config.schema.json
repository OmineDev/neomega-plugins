{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "interval": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 60,
      "default": 2.0
    },
    "stale_after": {
      "type": "number",
      "minimum": 1,
      "maximum": 300,
      "default": 10.0
    },
    "max_subscriptions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024,
      "default": 128
    },
    "event_capacity": {
      "type": "integer",
      "minimum": 16,
      "maximum": 1024,
      "default": 256
    },
    "subscription_ttl": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300,
      "default": 60
    }
  },
  "required": [],
  "additionalProperties": false
}
