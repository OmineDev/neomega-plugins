{
  "manifest_version": 1,
  "id": "neomega.warps",
  "version": "1.0.1",
  "host_api": {
    "major": 1,
    "min_minor": 4
  },
  "worker_protocol": {
    "major": 1,
    "min_minor": 0
  },
  "runtime": "python",
  "entrypoint": "main.py",
  "mode": "service",
  "session_required": true,
  "state_version": 1,
  "subscriptions": [
    {
      "name": "chat",
      "kind": "chat.received",
      "delivery": "durable"
    }
  ],
  "permissions": {
    "operations": [
      "framework.command.execute",
      "framework.entities.query"
    ],
    "players": [
      "list"
    ],
    "services": [
      "plugin.neomega.economy.pay"
    ],
    "purposes": {
      "event:chat.received": "接收玩家的 !传送点、!传送、!主城、!设重生点 等命令",
      "operation:framework.command.execute": "把玩家传送到传送点或主城、设置重生点，并回复玩家",
      "operation:framework.entities.query": "设传送点、设主城和设重生点时读取玩家当前的位置",
      "players:list": "确认发命令的玩家身份",
      "service:plugin.neomega.economy.pay": "设置了传送费并安装了经济插件时扣除金币"
    }
  },
  "dependencies": [
    {
      "id": "neomega.economy",
      "major": 2,
      "min_version": "2.0.0",
      "optional": true
    }
  ],
  "exports": []
}
